{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase Contract",
  "type": "object",
  "required": [
    "contract_id",
    "version",
    "run_id",
    "work_item",
    "layer_id",
    "state",
    "catalog_snapshot",
    "scope",
    "acceptance_checks",
    "attempt_budget",
    "evidence_refs"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "layer_id": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "X1",
        "X2",
        "X3",
        "M1"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "locked",
        "running",
        "pass",
        "block",
        "needs_human",
        "not_applicable",
        "superseded"
      ]
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1
    },
    "attempt_budget": {
      "type": "object"
    }
  }
}
